# Unity crash / build artifacts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude local settings
.claude/settings.local.json

# Offline compile check output
/Tools/CompileCheck/bin/
/Tools/CompileCheck/obj/

# Play-test captures
/Screenshots/
/Assets/InitTestScene*.unity*

# Player builds
/Builds/
